# Template only; not installed. Replace paths/user, verify deployment/pins first.
[Unit]
Description=HELI Devnet maintenance keeper
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=heli
WorkingDirectory=/opt/heli-project
ExecStart=/usr/bin/node /opt/heli-project/heli/keeper/run.mjs /etc/heli/keeper.json --execute
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/heli-project/heli/keeper/.state
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
